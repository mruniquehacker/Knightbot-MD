# Levanter runtime
NODE_ENV=production
BOT_NAME=Levanter
BOT_OWNER=Your Name
OWNER_NUMBER=international_digits_only
PREFIX=.
ALTERNATE_PREFIXES=/
BOT_MODE=public
TIMEZONE=Africa/Lagos
PAIRING_CODE=false
PAIRING_PHONE_NUMBER=
ALLOW_FROM_ME=true
SEND_CONNECT_MESSAGE=false

# Local state (keep outside the repository when possible)
DATA_PATH=./data/levanter-state.json
MAX_MESSAGE_LENGTH=4096
MAX_NOTES=100
MAX_CONVERSATION_MESSAGES=12
PROCESSED_MESSAGE_TTL_MS=86400000

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# AI provider; leave disabled until configured
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.4
AI_SYSTEM_PROMPT=You are Levanter, a concise and helpful personal WhatsApp assistant.
DIRECT_AI=true
GROUP_AI=false

# Logging
LOG_LEVEL=info
LOG_MESSAGE_CONTENT=false

# Optional legacy integrations. Leave blank unless the command is explicitly needed.
GIPHY_API_KEY=
XTEAM_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZ_API_KEY=
FGMODS_API_KEY=
